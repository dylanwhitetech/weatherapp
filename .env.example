# NWS API user agent string (required by NWS policy). Use your contact email.
# See: https://www.weather.gov/documentation/services-web-api
NWS_USER_AGENT=weatherapp-local (your@email.com)

# Default dashboard location (Walla Walla, WA).
WEATHER_LOCATION_NAME=Walla Walla, WA
WEATHER_LATITUDE=46.0646
WEATHER_LONGITUDE=-118.3430
WEATHER_TIMEZONE=America/Los_Angeles

# Weather map providers.
AIRNOW_API_KEY=
AIRNOW_BASE_URL=https://www.airnowapi.org
AIRNOW_SEARCH_DISTANCE_MILES=75

# Optional map tuning.
MAP_CYCLE_SECONDS=8
MAP_DEFAULT_ZOOM=6
MAP_OVERLAY_OPACITY=0.65
MAP_CACHE_TTL_SECONDS=600
